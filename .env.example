# Copy to .env or set environment variables on your hosting platform.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# For production, REQUIRED: 64 hexadecimal characters (32 random bytes).
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# APP_ENCRYPTION_KEY=
# DB_DIR=./data
# ORIGIN=https://your-real-domain.example
# AI_CALL_TIMEOUT_MS=45000

# V2 optional Gmail OAuth (create a Google Cloud OAuth Web application)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/workspace/gmail/callback
# Use the same browser hostname/port as the configured redirect URI.
# MAX_AI_MODELS=8 (default, configurable up to 20)

# Netlify build variable (public backend origin only; not an API key)
# OMNI_BACKEND_URL=https://your-backend.example.com

# Optional Ollama on the SAME backend host, listening on 127.0.0.1:11434
# OLLAMA_ENABLED=true
